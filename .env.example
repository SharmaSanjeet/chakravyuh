# Copy to .env and adjust. All variables use the CHAKRAVYUH_ prefix.

# Storage
CHAKRAVYUH_DB_PATH=chakravyuh.db
# CHAKRAVYUH_WEB_DIST=web/dist          # path to the frontend build (auto if next to the package)

# Ports
CHAKRAVYUH_HONEYPOT_PORT=8080
CHAKRAVYUH_DASHBOARD_PORT=5000

# Public URL of the Chakravyuh server (the one remote sensors connect to)
# CHAKRAVYUH_PUBLIC_URL=https://chakravyuh.example.com

# Content generation
# CHAKRAVYUH_SEED=                      # empty = a seed is generated per deployment (anti-fingerprint)
CHAKRAVYUH_GENERATION_MODE=Template     # Template | Mimic | Static
# CHAKRAVYUH_TARGET_URL=https://example.com   # Mimic only
# Built-in site profile (saas|corp|ecommerce|nonprofit): realistic route taxonomy, lexicon and
# API collections without crawling. Empty = generic seed-based maze. More profiles:
# scripts/build_profile.py crawls an authorized site and generates chakravyuh/profiles/<name>.json.
# CHAKRAVYUH_SITE_PROFILE=saas
CHAKRAVYUH_REALISM_LEVEL=3              # 1..5

# World: INERT multi-site static content (primary source; replaces the generated maze).
# The honeypot serves real files from a directory tree on disk; ONLY bytes, never executes anything.
# With a World active the maze is OFF (it was the source of the autogenerated-content tells).
CHAKRAVYUH_WORLD_ENABLED=true
# CHAKRAVYUH_WORLD_PATH=                # empty = next to the DB (<DB dir>/world)
CHAKRAVYUH_WORLD_AUTOSEED=true          # if the World is empty, copies the packaged curated seed
# CHAKRAVYUH_VOCABULARY_THEME=          # corporate|devops|saas|ecommerce ("" = by seed)
CHAKRAVYUH_TARPIT_DELAY_MS=0            # fixed base delay per response (ms)

# Adaptive tarpit: the maze is coherent and finite by default (undetectable); only when a
# session is confirmed as a hostile agent (high score) does the intensity rise -> longer
# prose/logs and a growing delay that burns the agent's tokens/wall-clock. Invisible to humans.
CHAKRAVYUH_ADAPTIVE_TARPIT=true
CHAKRAVYUH_TARPIT_MAX_MS=6000          # max delay per response at intensity 3 (confirmed agent)
# Opt-in for "raw burning": at maximum intensity the API goes back to endless pagination (breaks
# stealth, becomes fingerprintable again). OFF by default = the coherence invariant is preserved.
CHAKRAVYUH_ALLOW_INFINITE_ON_CONFIRMED=false
# CTF scenario (corp-breach): false = realistic maze only (maximum stealth, does not reveal
# the honeypot pattern); true = active lure (breadcrumb chain + credential-reuse gate).
CHAKRAVYUH_SCENARIOS_ENABLED=false

# Detection / alerts
CHAKRAVYUH_ALERT_SCORE_THRESHOLD=0.5
CHAKRAVYUH_ALERT_MIN_REQUESTS=5

# Blocking / notifications
CHAKRAVYUH_ENFORCE_BLOCK=true
CHAKRAVYUH_AUTO_BLOCK_SCORE=0.0        # 0 = score-based auto-block disabled (credential_reuse always blocks)
# CHAKRAVYUH_WEBHOOK_URL=
# CHAKRAVYUH_WEBHOOK_SECRET=
CHAKRAVYUH_ENABLE_IPTABLES=false

# Dashboard authentication (single admin)
CHAKRAVYUH_ADMIN_USER=admin
# CHAKRAVYUH_ADMIN_PASSWORD=            # empty = one is generated and printed to the log (once)
# CHAKRAVYUH_SESSION_SECRET=           # empty = generated and persisted next to the DB (stable per deployment)
CHAKRAVYUH_SESSION_MAX_AGE=86400       # session lifetime in seconds
CHAKRAVYUH_COOKIE_SECURE=false         # true after TLS (admin subdomain); false on local/http tunnel

# AI confirmation (optional; the system works without it)
CHAKRAVYUH_AI_ENABLED=false
CHAKRAVYUH_AI_PROVIDER=heuristic        # heuristic | openai
# CHAKRAVYUH_AI_BASE_URL=https://openrouter.ai/api/v1
# CHAKRAVYUH_AI_API_KEY=
# CHAKRAVYUH_AI_MODEL=anthropic/claude-haiku-5.5

# Architect: AI agent that builds/evolves the World + the lure (on demand).
# `python -m chakravyuh.architect build|evolve`. Guide: docs/ARCHITECT.md
CHAKRAVYUH_ARCHITECT_PROVIDER=stub     # stub (no AI) | api (Anthropic) | claude_cli (subscription)
# CHAKRAVYUH_ARCHITECT_MODEL=claude-sonnet-4-5
# CHAKRAVYUH_ARCHITECT_API_KEY=        # provider=api; if empty, falls back to CHAKRAVYUH_AI_API_KEY
# CHAKRAVYUH_ARCHITECT_BASE_URL=https://api.anthropic.com
CHAKRAVYUH_ARCHITECT_PORTALS=4
# CHAKRAVYUH_ARCHITECT_BRAND=
# For claude_cli: export CLAUDE_CODE_OAUTH_TOKEN=$(claude setup-token)
